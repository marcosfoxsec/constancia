{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(gh issue view *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(npx supabase test db)"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./docs/AUTONOMIA.md)",
      "Edit(./supabase/migrations/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git push * main)",
      "Bash(supabase db push*)",
      "Bash(supabase link*)",
      "Bash(npx supabase db push*)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/proteger-caminhos.sh",
            "args": []
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --silent exec prettier --write --ignore-unknown \"$(jq -r '.tool_input.file_path')\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verificar-pronto.sh",
            "args": [],
            "timeout": 900
          }
        ]
      }
    ]
  }
}
